---
import { asset } from "../utils/url";
const { scrollable = false } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Интерактивное 3D-резюме Дмитрия Рябова: прогулка по ночному городу с проектами и опытом." />
    <meta name="theme-color" content="#05070f" />
    <link rel="icon" type="image/svg+xml" href={asset("/favicon.svg")} />
    <link rel="icon" href={asset("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <title>Дмитрий Рябов — 3D-резюме</title>
  </head>
  <body class={scrollable ? "scrollable" : ""}>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    background: #05070f;
  }
  /* Экран загрузки: общий вид для статической разметки и React-прелоадера */
  :global(.boot) {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: grid;
    place-items: center;
    background: #05070f;
    color: #eaf1ff;
    font-family: system-ui, sans-serif;
  }
  :global(.boot__mark) {
    grid-area: 1 / 1;
    font: 700 28px/1 system-ui, sans-serif;
    letter-spacing: 0.08em;
    color: #cfe0ff;
  }
  :global(.boot__ring) {
    grid-area: 1 / 1;
    width: 132px;
    height: 132px;
    transform: rotate(-90deg);
  }
  :global(.boot__ring circle) {
    fill: none;
    stroke: #6aa9ff;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 289;
    stroke-dashoffset: 217;
    filter: drop-shadow(0 0 6px rgba(106, 169, 255, 0.7));
    transform-origin: 50% 50%;
    animation: boot-spin 1.4s linear infinite;
  }
  :global(.boot__text) {
    grid-area: 1 / 1;
    align-self: end;
    margin-bottom: 18vh;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(200, 220, 255, 0.7);
  }
  @keyframes boot-spin {
    to {
      transform: rotate(360deg);
    }
  }
  body:not(.scrollable) {
    overflow: hidden;
    width: 100%;
    height: 100vh;
    height: 100dvh;
  }
</style>
