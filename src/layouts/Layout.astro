---
const { scrollable = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>#3d-resume</title>
  </head>
  <body class={scrollable ? "scrollable" : ""}>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    background: #0b1024;
  }
  body:not(.scrollable) {
    overflow: hidden;
    width: 100%;
    height: 100vh;
    height: 100dvh;
  }
</style>
